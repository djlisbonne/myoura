# --- Oura (OAuth2) ---
# Oura discontinued Personal Access Tokens in 2025; the API now uses OAuth2.
# 1. Create an application at https://cloud.ouraring.com/oauth/applications
# 2. Add this exact Redirect URI to it (must match OURA_REDIRECT_URI below):
#       http://localhost:8000/api/auth/callback
# 3. Copy the client id/secret here, then click "Connect Oura" in the app.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Optional legacy fallback if your account still has a Personal Access Token.
OURA_PERSONAL_ACCESS_TOKEN=

# --- AI chat (optional) ---
# Anthropic API key from https://console.anthropic.com/settings/keys
# If unset, the chat panel is disabled and everything else still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Server ---
HOST=localhost
PORT=8000
# Where the SQLite database lives (created automatically).
OURA_DB_PATH=data/oura.db
