# --- Oura ---
# Personal Access Token from https://cloud.ouraring.com/personal-access-tokens
# This is all you need for a single-user local app. No OAuth, no callback URL.
OURA_PERSONAL_ACCESS_TOKEN=

# --- AI chat (optional) ---
# Anthropic API key from https://console.anthropic.com/settings/keys
# If unset, the chat panel is disabled and everything else still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Server ---
HOST=127.0.0.1
PORT=8000
# Where the SQLite database lives (created automatically).
OURA_DB_PATH=data/oura.db
